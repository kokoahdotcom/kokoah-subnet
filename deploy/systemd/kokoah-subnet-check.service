[Unit]
Description=Kokoah subnet health check (alerts only on a problem)
After=network-online.target docker.service

[Service]
Type=oneshot
User=kokoah-subnet
Group=kokoah-subnet
Environment=HOME=/var/lib/kokoah-subnet
EnvironmentFile=/etc/kokoah-subnet/db.env
EnvironmentFile=-/etc/kokoah-subnet/alert.env
WorkingDirectory=/var/lib/kokoah-subnet
ExecStart=/opt/kokoah-subnet/venv/bin/kokoah-subnet validator check --only-problems
SuccessExitStatus=1
MemoryMax=512M
ReadWritePaths=/var/lib/kokoah-subnet
StandardOutput=append:/var/log/kokoah-subnet/check.log
StandardError=append:/var/log/kokoah-subnet/check.log
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
