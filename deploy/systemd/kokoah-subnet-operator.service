[Unit]
Description=Kokoah subnet operator step: commit yesterday's builder file hash from the owner hotkey (once it is published)

[Service]
Environment=HOME=%h
Type=oneshot
WorkingDirectory=/kokoah/kokoah-subnet
ExecStart=/bin/bash -c 'day=$(date -u -d "yesterday" +%%Y-%%m-%%d); stamp=$HOME/.local/share/kokoah/subnet-operator-$day.done; [ -f "$stamp" ] && exit 0; /kokoah/kokoah-subnet/.venv/bin/python -m kokoah_subnet.cli owner commit-file --network test --netuid <N> --day "$day" --builder 0x43ccc0618e4358494f87a4b8699230203dc4ab67 --wallet <owner wallet> --wallet-hotkey <owner hotkey> >> $HOME/.local/share/kokoah/subnet-operator.log 2>&1 && touch "$stamp"'
