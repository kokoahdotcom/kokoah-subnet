[Unit]
Description=Kokoah subnet operator step: commit yesterday's builder file hash from the owner hotkey (once it is published)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kokoah-subnet-operator
Group=kokoah-subnet-operator
Environment=HOME=/var/lib/kokoah-subnet-operator
# KOKOAH_SUBNET_OPERATOR_ARGS: --network, --netuid and --builder (the wallet flags come after them and win)
EnvironmentFile=/etc/kokoah-subnet/operator.env
# the owner hotkey stays where it is (/etc/kokoah-subnet/operator-wallet/hotkey, root's alone): systemd hands it to
# this run only, in a private place, and it is put together as a wallet named "owner"; no validator can read it
LoadCredential=hotkey:/etc/kokoah-subnet/operator-wallet/hotkey
RuntimeDirectory=kokoah-subnet-operator
StateDirectory=kokoah-subnet-operator
WorkingDirectory=/var/lib/kokoah-subnet-operator
ExecStartPre=/bin/mkdir -p %t/kokoah-subnet-operator/wallets/owner/hotkeys
ExecStartPre=/bin/ln -sfn /run/credentials/%n/hotkey %t/kokoah-subnet-operator/wallets/owner/hotkeys/default
# once a day's hash is committed, the later runs that day do nothing
ExecStart=/bin/bash -c 'day=$$(date -u -d yesterday +%%F); stamp=/var/lib/kokoah-subnet-operator/$${day}.done; [ -f "$$stamp" ] && exit 0; /opt/kokoah-subnet/venv/bin/kokoah-subnet owner commit-file --day "$$day" $$KOKOAH_SUBNET_OPERATOR_ARGS --wallet owner --wallet-hotkey default --wallet-path %t/kokoah-subnet-operator/wallets && touch "$$stamp"'
MemoryMax=1G
TasksMax=64
TimeoutStartSec=15min
# the validator's folder, record and connection are not this step's
InaccessiblePaths=-/var/lib/kokoah-subnet -/etc/kokoah-subnet/db.env -/etc/kokoah-subnet/db-reader.env
StandardOutput=append:/var/log/kokoah-subnet/operator.log
StandardError=append:/var/log/kokoah-subnet/operator.log
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0077
