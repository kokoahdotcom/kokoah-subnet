   "type": "timeseries",
   "title": "Alpha paid and burned per day",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "kokoah-subnet-pg"
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
