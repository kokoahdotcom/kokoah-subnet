{
 "uid": "kokoah-subnet-overview",
 "title": "Kokoah subnet overview",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-90d",
  "to": "now"
 },
 "refresh": "5m",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Volume through the builder code (USD per day)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "kokoah-subnet-pg"
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::date AS time, volume_usd AS \"volume\" FROM days ORDER BY day",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "kokoah-subnet-pg"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Builder fees collected (USD per day)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "kokoah-subnet-pg"
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::date AS time, builder_fee_usd AS \"fees\" FROM days ORDER BY day",
     "datasource": {
      "type": "grafana-postgresql-datasource",
