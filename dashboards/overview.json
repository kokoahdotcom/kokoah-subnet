   "type": "timeseries",
   "title": "Miners scored and with fills",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "kokoah-subnet-pg"
   },
   "targets": [
    {
     "refId": "A",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT day::date AS time, miners AS \"scored\", miners_with_fills AS \"with fills\" FROM days ORDER BY day",
     "datasource": {
      "type": "grafana-postgresql-datasource",
