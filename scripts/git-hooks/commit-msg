#!/usr/bin/env bash
# One author per commit and no AI mentions: refuse trailers that name anyone else and messages that mention Claude or AI.
set -euo pipefail
msg="$1"
if grep -qiE '^(Co-Authored-By|Signed-off-by|Reviewed-by|Authored-by|Generated with)' "$msg"; then
  echo "commit-msg: trailers naming another author are not allowed" >&2
  exit 1
fi
if grep -v '^#' "$msg" | grep -qiE '\bclaude\b|\banthropic\b|\bAI\b|\bLLM\b'; then
  echo "commit-msg: no mention of Claude or AI in commit messages" >&2
  exit 1
fi
